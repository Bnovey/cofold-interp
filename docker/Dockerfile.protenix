# Build: docker build -t igv-protenix -f docker/Dockerfile.protenix .   (context = repo root)
# Run:   docker run --gpus all --shm-size=32g --ipc=host igv-protenix
#
# Protenix conflicts with boltz==2.2.1 (numpy, biopython, gemmi, etc.) and
# pins cuequivariance 0.8.0 which segfaults on A100. This image installs
# protenix with --no-deps and an explicit dependency list, excluding
# cuequivariance and deepspeed. LAYERNORM_TYPE is set to avoid the nvcc JIT.
#
# Uses ONLY the Apache-2.0 protenix_base_default_v1.0.0 weights.

FROM nvidia/cuda:12.6.2-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV LAYERNORM_TYPE=torch_layernorm

# Python 3.11
RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common curl ca-certificates && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-distutils && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    rm -rf /var/lib/apt/lists/*

# torch (cu126 wheel index)
RUN python3 -m pip install --no-cache-dir \
        torch==2.7.1+cu126 --index-url https://download.pytorch.org/whl/cu126

# protenix with --no-deps, then its actual dependencies minus the problematic ones
RUN python3 -m pip install --no-cache-dir --no-deps protenix==2.0.0

# torchvision / torchaudio must come from the same cu126 index as torch above,
# or pip pulls the default-CUDA build and silently mismatches.
RUN python3 -m pip install --no-cache-dir \
        torchvision==0.22.1+cu126 torchaudio==2.7.1+cu126 \
        --index-url https://download.pytorch.org/whl/cu126

# protenix 2.0.0 declares 32 requires_dist entries. Because we install it with
# --no-deps (see above), every one of them has to be listed here or the import
# fails at runtime with ModuleNotFoundError -- which is exactly what happened on
# 2026-11-04 (optree), costing a GPU session. Pins mirror requires_dist exactly.
#
# Deliberately EXCLUDED, do not re-add without re-testing on an A100:
#   cuequivariance-torch==0.8.0, cuequivariance-ops-torch-cu12==0.8.0  (segfault)
#   deepspeed==0.17.5                                                  (unused)
RUN python3 -m pip install --no-cache-dir \
        PyYAML==6.0.2 \
        biopython==1.85 \
        biotite==1.4.0 \
        fair-esm==2.0.0 \
        gemmi==0.6.7 \
        icecream==2.1.7 \
        ipdb==0.13.13 \
        ipywidgets==8.1.7 \
        matplotlib==3.10.5 \
        ml_collections==1.1.0 \
        modelcif==1.4 \
        "networkx>=3.4.2" \
        numpy==2.4.1 \
        optree==0.17.0 \
        pandas==2.3.1 \
        pdbeccdutils==1.0.0 \
        protobuf==6.31.1 \
        py3Dmol==2.5.2 \
        "pydantic>=2.0.0" \
        rdkit==2025.9.3 \
        scikit-learn==1.7.1 \
        scikit-learn-extra==0.3.0 \
        "scipy>=1.9.0" \
        tqdm==4.67.1 \
        triton==3.3.1 \
        wandb==0.21.1 \
        einops \
        requests \
        pyarrow

# Clone Protenix repo for configs/ and runner/ (not in pip package)
RUN apt-get update && apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v2.0.0 \
        https://github.com/bytedance/Protenix.git /opt/protenix

WORKDIR /app
COPY . /app
RUN python3 -m pip install --no-cache-dir -e ".[dev]"

RUN git config --global --add safe.directory /app

# Verify protenix imports AND that every declared dependency actually resolves.
# A bare `import protenix` does not touch the lazily-imported modules that bit us.
RUN python3 -c "import protenix; print('protenix', protenix.__version__)" && \
    python3 -c "import optree, icecream, ipdb, py3Dmol, esm, matplotlib, ipywidgets, \
pdbeccdutils, sklearn_extra, torchvision, torchaudio, networkx, pydantic, google.protobuf; \
print('all protenix deps import OK')"

CMD ["python3", "-m", "pytest", "tests/test_protenix_score.py", "-v"]
